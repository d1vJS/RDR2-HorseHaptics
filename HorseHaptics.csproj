<Project Sdk="Microsoft.NET.Sdk">
  <!-- Visual Studio 2022 ile aç, "Release" seç, Build et.
       ScriptHookRDRNetAPI.dll yolunu kendi dosyana göre düzelt (Halen84'ün release arşivinden). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>HorseHaptics</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ScriptHookRDRNetAPI">
      <HintPath>ScriptHookRDRNetAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
